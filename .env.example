# Spotify API Configuration
# Copy this file to .env — `uv run get_token.py` fills in the tokens for you.

# From https://developer.spotify.com/dashboard (your app's settings).
# Add http://127.0.0.1:8888/callback to the app's Redirect URIs.
SPOTIFY_CLIENT_ID="your_client_id_here"
SPOTIFY_CLIENT_SECRET="your_client_secret_here"

# Written automatically by get_token.py after you authorize in the browser.
SPOTIFY_ACCESS_TOKEN=""
SPOTIFY_REFRESH_TOKEN=""

# Optional: change if port 8888 is already in use on your machine.
# Must match the Redirect URI configured in the Spotify dashboard.
#SPOTIFY_REDIRECT_PORT="8888"
